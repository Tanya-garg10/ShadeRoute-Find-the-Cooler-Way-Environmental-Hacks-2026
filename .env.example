# PORT: Local development server port (default: 3000)
PORT=3000

# NODE_ENV: Environment mode (development, production)
NODE_ENV=development

# AWS Credentials (Required for AWS Lambda deployment only)
# Configure these if deploying to AWS Lambda + API Gateway
# Local development works without these credentials
AWS_ACCESS_KEY_ID="your_aws_access_key_id"
AWS_SECRET_ACCESS_KEY="your_aws_secret_access_key"
AWS_REGION="ap-south-1"

# VITE_API_URL: Your deployed AWS API Gateway endpoint
# Only needed if using AWS backend instead of local Express server
# Example: https://xxxxxx.execute-api.ap-south-1.amazonaws.com
VITE_API_URL=""

# Optional: OpenRouteService API Key (if switching from OSRM)
# Current implementation uses free OSRM API, no key required
OPENROUTESERVICE_API_KEY=""

# Optional: GEMINI_API_KEY (for AI Studio deployment)
# AI Studio automatically injects this at runtime from user secrets
GEMINI_API_KEY=""

# Optional: APP_URL (for AI Studio deployment)
# AI Studio automatically injects this at runtime with the Cloud Run service URL
APP_URL=""
