# PORT: Local development server port (default: 3000)
PORT=3000

# NODE_ENV: Environment mode (development, production)
NODE_ENV=development

# Featherless AI — OpenAI-compatible inference API (https://featherless.ai)
# Required for AI Heat Advisory, Departure Advisor, and Community Analysis features
# Get your free API key at: https://featherless.ai
FEATHERLESS_API_KEY="your_featherless_api_key"

# Optional: Override the default Featherless model
# Default: meta-llama/Llama-3.3-70B-Instruct
FEATHERLESS_MODEL="meta-llama/Llama-3.3-70B-Instruct"

# AWS Credentials (Required for AWS Lambda deployment only)
# Configure these if deploying to AWS Lambda + API Gateway
# Local development works without these credentials
AWS_ACCESS_KEY_ID="your_aws_access_key_id"
AWS_SECRET_ACCESS_KEY="your_aws_secret_access_key"
AWS_REGION="ap-south-1"

# VITE_API_URL: Your deployed AWS API Gateway endpoint
# Only needed if using AWS backend instead of local Express server
# Example: https://xxxxxx.execute-api.ap-south-1.amazonaws.com
VITE_API_URL=""

# Optional: APP_URL (for Cloud Run deployment)
APP_URL=""
